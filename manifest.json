{
  "manifest_version": 2,
  "name": "Sidetrack",
  "version": "0.1.0",
  "description": "Local playlists of YouTube videos, playing in the sidebar while you browse.",
  "browser_specific_settings": {
    "gecko": { "id": "sidetrack@tom-tour" }
  },
  "permissions": [
    "storage",
    "tabHide",
    "https://www.youtube.com/*",
    "https://tom-tour.github.io/*"
  ],
  "background": { "scripts": ["vendor/peerjs.min.js", "background.js", "room.js"] },
  "content_scripts": [
    {
      "matches": ["https://tom-tour.github.io/sidetrack/player/*"],
      "js": ["player-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "sidebar_action": {
    "default_title": "Sidetrack",
    "default_panel": "sidebar.html",
    "open_at_install": true
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": { "default": "Alt+Shift+Y" }
    }
  }
}
