{
  "manifest_version": 2,
  "name": "Sidetrack",
  "version": "0.1.0",
  "description": "Local playlists of YouTube videos, playing in the sidebar while you browse.",
  "browser_specific_settings": {
    "gecko": { "id": "sidetrack@tom-tour" }
  },
  "permissions": [
    "storage",
    "https://www.youtube.com/oembed*"
  ],
  "sidebar_action": {
    "default_title": "Sidetrack",
    "default_panel": "sidebar.html",
    "open_at_install": true
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": { "default": "Alt+Shift+Y" }
    }
  }
}
